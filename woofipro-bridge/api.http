### Variables
@baseUrl = http://localhost:8081
@apiKey = test
@symbol = ADA/USDC:USDC

# Перекрытия ключей/среды для CCXT (заполни своими значениями)
@wooApiKey = ed25519:YOUR_ORDERLY_KEY
@wooApiSecret = YOUR_ORDERLY_SECRET
@wooAccountId = 0xYOUR_ACCOUNT_ID
@wooBrokerId = woofi_pro
@env = testnet

@order_id = 2776119174


### Health check
GET {{baseUrl}}/health
X-API-Key: {{apiKey}}


### Who am I (проверить подключение и env)
GET {{baseUrl}}/whoami?apiKey={{wooApiKey}}&apiSecret={{wooApiSecret}}&accountId={{wooAccountId}}&brokerId={{wooBrokerId}}&env={{env}}
X-API-Key: {{apiKey}}


### Get markets (узнать доступные символы)
GET {{baseUrl}}/markets?apiKey={{wooApiKey}}&apiSecret={{wooApiSecret}}&accountId={{wooAccountId}}&brokerId={{wooBrokerId}}&env={{env}}
X-API-Key: {{apiKey}}


### Get ticker
GET {{baseUrl}}/ticker/{{symbol}}?apiKey={{wooApiKey}}&apiSecret={{wooApiSecret}}&accountId={{wooAccountId}}&brokerId={{wooBrokerId}}&env={{env}}
X-API-Key: {{apiKey}}


### Get OHLCV (candles)
# Примечание: этот эндпоинт должен быть реализован в сервере. Если его нет — будет 404.
GET {{baseUrl}}/ohlcv?symbol={{symbol}}&timeframe=1m&limit=10&apiKey={{wooApiKey}}&apiSecret={{wooApiSecret}}&accountId={{wooAccountId}}&brokerId={{wooBrokerId}}&env={{env}}
X-API-Key: {{apiKey}}


### Create market order
POST {{baseUrl}}/order?apiKey={{wooApiKey}}&apiSecret={{wooApiSecret}}&accountId={{wooAccountId}}&env={{env}}
X-API-Key: {{apiKey}}
Content-Type: application/json

{
  "symbol": "{{symbol}}",
  "side": "sell",
  "type": "market",

  "amount": 1,
  "clientOrderId": "bot-{{$timestamp}}"
}

> {%
    client.test("Accepted 200", function () {
        client.assert(response.status === 200, "Expected 200");
    });
    const body = typeof response.body === 'string' ? JSON.parse(response.body) : response.body;
    if (body && (body.id || body.orderId)) {
        const id = body.id ?? body.orderId;
        client.global.set("order_id", id);
        client.log("Stored order_id=" + id);
    } else {
        client.log("order_id not found in response: " + JSON.stringify(body));
    }
%}


### Get order by ID
GET {{baseUrl}}/order/{{order_id}}?symbol={{symbol}}&apiKey={{wooApiKey}}&apiSecret={{wooApiSecret}}&accountId={{wooAccountId}}&brokerId={{wooBrokerId}}&env={{env}}
X-API-Key: {{apiKey}}


### Cancel order
POST {{baseUrl}}/cancel?symbol={{symbol}}&order_id={{order_id}}&apiKey={{wooApiKey}}&apiSecret={{wooApiSecret}}&accountId={{wooAccountId}}&brokerId={{wooBrokerId}}&env={{env}}
X-API-Key: {{apiKey}}


### Get open orders
GET {{baseUrl}}/orders?status=open&symbol={{symbol}}&limit=20&apiKey={{wooApiKey}}&apiSecret={{wooApiSecret}}&accountId={{wooAccountId}}&brokerId={{wooBrokerId}}&env={{env}}
X-API-Key: {{apiKey}}


### Get closed orders
GET {{baseUrl}}/orders?status=closed&symbol={{symbol}}&limit=20&apiKey={{wooApiKey}}&apiSecret={{wooApiSecret}}&accountId={{wooAccountId}}&brokerId={{wooBrokerId}}&env={{env}}
X-API-Key: {{apiKey}}


### Get all orders
GET {{baseUrl}}/orders?status=all&symbol={{symbol}}&limit=20&apiKey={{wooApiKey}}&apiSecret={{wooApiSecret}}&accountId={{wooAccountId}}&brokerId={{wooBrokerId}}&env={{env}}
X-API-Key: {{apiKey}}


### Get positions
GET {{baseUrl}}/positions?only_open=false&symbol={{symbol}}&apiKey={{wooApiKey}}&apiSecret={{wooApiSecret}}&accountId={{wooAccountId}}&brokerId={{wooBrokerId}}&env={{env}}
X-API-Key: {{apiKey}}


### Stream ticker (Server-Sent Events)
GET {{baseUrl}}/stream/ticker?symbol={{symbol}}&interval_ms=1000&apiKey={{wooApiKey}}&apiSecret={{wooApiSecret}}&accountId={{wooAccountId}}&brokerId={{wooBrokerId}}&env={{env}}
X-API-Key: {{apiKey}}
Accept: text/event-stream


### Get balance
GET {{baseUrl}}/balance?apiKey={{wooApiKey}}&apiSecret={{wooApiSecret}}&accountId={{wooAccountId}}&brokerId={{wooBrokerId}}&env={{env}}
X-API-Key: {{apiKey}}


### Set leverage
PUT {{baseUrl}}/positions/{{symbol}}/leverage?apiKey={{wooApiKey}}&apiSecret={{wooApiSecret}}&accountId={{wooAccountId}}&brokerId={{wooBrokerId}}&env={{env}}
X-API-Key: {{apiKey}}
Content-Type: application/json

{
  "leverage": 12,
  "marginMode": "isolated"
}

### Get current leverage (by symbol)
GET {{baseUrl}}/positions/{{symbol}}/leverage?apiKey={{wooApiKey}}&apiSecret={{wooApiSecret}}&accountId={{wooAccountId}}&brokerId={{wooBrokerId}}&env={{env}}
X-API-Key: {{apiKey}}

> {%
    client.test("Accepted 200", function () {
        client.assert(response.status === 200, "Expected 200");
    });
    const body = typeof response.body === 'string' ? JSON.parse(response.body) : response.body;
    client.log("Leverage for {{symbol}} = " + body.leverage + " (source: " + body.source + ")");
%}


### Get current leverage + tiers (limits if supported)
GET {{baseUrl}}/positions/{{symbol}}/leverage?include_tiers=true&apiKey={{wooApiKey}}&apiSecret={{wooApiSecret}}&accountId={{wooAccountId}}&brokerId={{wooBrokerId}}&env={{env}}
X-API-Key: {{apiKey}}

> {%
    client.test("Accepted 200", function () {
        client.assert(response.status === 200, "Expected 200");
    });
    const body = typeof response.body === 'string' ? JSON.parse(response.body) : response.body;
    client.log("Leverage = " + body.leverage);
    if (body.tiers) client.log("Leverage tiers: " + JSON.stringify(body.tiers));
    if (body.warning) client.log("Warning: " + body.warning);
%}

