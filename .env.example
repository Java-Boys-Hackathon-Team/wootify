# Скопируйте в .env и задайте свои значения. Файл .env не коммитится.

# PostgreSQL
POSTGRES_USER=wootify
POSTGRES_PASSWORD=change-me

# Общий секрет между приложением и woofipro-bridge
BRIDGE_API_KEY=change-me

# Ключ шифрования секретов API в БД (base64, 32 байта).
# Сгенерировать: openssl rand -base64 32
WOOTIFY_ENCRYPTION_KEY=

# Пароль администратора UI. Если задан, применяется при каждом старте.
WOOTIFY_ADMIN_PASSWORD=

# Идентификатор экземпляра приложения (владелец ботов). Должен быть стабильным между перезапусками.
WOOTIFY_INSTANCE_ID=wootify-1

# Порт UI на хосте
WOOTIFY_PORT=8088

# pgAdmin (профиль tools)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me
