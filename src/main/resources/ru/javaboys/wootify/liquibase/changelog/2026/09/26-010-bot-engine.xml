<?xml version="1.0" encoding="UTF-8"?>
<!--
  Движок ботов: конфигурация бота и настройки DCA, состояние исполнения, журнал событий,
  циклы стратегии, ордера симулятора. Прототипные таблицы BOT и BOT_SETTINGS времён хакатона
  не содержали торговых данных и пересоздаются.
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <changeSet id="1" author="wootify">
        <dropTable tableName="BOT_SETTINGS" cascadeConstraints="true"/>
        <dropTable tableName="BOT" cascadeConstraints="true"/>
    </changeSet>

    <changeSet id="2" author="wootify">
        <createTable tableName="DCA_SETTINGS">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_DCA_SETTINGS"/>
            </column>
            <column name="VERSION" type="INT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="DIRECTION" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="DEPOSIT" type="DECIMAL(19, 8)">
                <constraints nullable="false"/>
            </column>
            <column name="LEVERAGE" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="ORDERS_COUNT" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="GRID_RANGE_PERCENT" type="DECIMAL(9, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="VOLUME_MULTIPLIER" type="DECIMAL(9, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="TAKE_PROFIT_PERCENT" type="DECIMAL(9, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="STOP_LOSS_PERCENT" type="DECIMAL(9, 4)"/>
            <column name="MAX_CYCLES" type="INT"/>
            <column name="CYCLE_COOLDOWN_SEC" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="3" author="wootify">
        <createTable tableName="BOT">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_BOT"/>
            </column>
            <column name="VERSION" type="INT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="NAME" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="DESCRIPTION" type="VARCHAR(1000)"/>
            <column name="STRATEGY_TYPE" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="TRADING_MODE" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="NETWORK" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="SYMBOL_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="ACCOUNT_ID" type="UUID"/>
            <column name="API_KEY_ID" type="UUID"/>
            <column name="TICK_INTERVAL_SEC" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="MAX_RESTARTS" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="STOP_ACTION" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="DCA_SETTINGS_ID" type="UUID"/>
            <column name="CREATED_DATE" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="CREATED_BY" type="VARCHAR(255)"/>
            <column name="LAST_MODIFIED_DATE" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
        <addUniqueConstraint tableName="BOT" columnNames="NAME" constraintName="IDX_BOT_UNQ_NAME"/>
        <createIndex tableName="BOT" indexName="IDX_BOT_SYMBOL">
            <column name="SYMBOL_ID"/>
        </createIndex>
        <createIndex tableName="BOT" indexName="IDX_BOT_ACCOUNT">
            <column name="ACCOUNT_ID"/>
        </createIndex>
        <createIndex tableName="BOT" indexName="IDX_BOT_API_KEY">
            <column name="API_KEY_ID"/>
        </createIndex>
        <createIndex tableName="BOT" indexName="IDX_BOT_DCA_SETTINGS">
            <column name="DCA_SETTINGS_ID"/>
        </createIndex>
        <addForeignKeyConstraint baseTableName="BOT" baseColumnNames="SYMBOL_ID" constraintName="FK_BOT_ON_SYMBOL"
                                 referencedTableName="SYMBOL" referencedColumnNames="ID"/>
        <addForeignKeyConstraint baseTableName="BOT" baseColumnNames="ACCOUNT_ID" constraintName="FK_BOT_ON_ACCOUNT"
                                 referencedTableName="ACCOUNT" referencedColumnNames="ID"/>
        <addForeignKeyConstraint baseTableName="BOT" baseColumnNames="API_KEY_ID" constraintName="FK_BOT_ON_API_KEY"
                                 referencedTableName="API_KEY" referencedColumnNames="ID"/>
        <addForeignKeyConstraint baseTableName="BOT" baseColumnNames="DCA_SETTINGS_ID"
                                 constraintName="FK_BOT_ON_DCA_SETTINGS"
                                 referencedTableName="DCA_SETTINGS" referencedColumnNames="ID"/>
    </changeSet>

    <changeSet id="4" author="wootify">
        <createTable tableName="BOT_RUNTIME">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_BOT_RUNTIME"/>
            </column>
            <column name="BOT_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="DESIRED_STATE" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="STATUS" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="REQUESTED_STOP_ACTION" type="VARCHAR(32)"/>
            <column name="OWNER_INSTANCE" type="VARCHAR(100)"/>
            <column name="LEASE_UNTIL" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="LAST_HEARTBEAT" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="STARTED_AT" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="STOPPED_AT" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="RESTART_COUNT" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="NEXT_RESTART_AT" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="LAST_ERROR" type="VARCHAR(4000)"/>
            <column name="LAST_ERROR_AT" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="STATUS_MESSAGE" type="VARCHAR(1000)"/>
            <column name="TICK_COUNT" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="STRATEGY_STATE" type="CLOB"/>
            <column name="UPDATED_AT" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
        <addUniqueConstraint tableName="BOT_RUNTIME" columnNames="BOT_ID" constraintName="IDX_BOT_RUNTIME_UNQ_BOT"/>
        <createIndex tableName="BOT_RUNTIME" indexName="IDX_BOT_RUNTIME_OWNER">
            <column name="OWNER_INSTANCE"/>
        </createIndex>
        <addForeignKeyConstraint baseTableName="BOT_RUNTIME" baseColumnNames="BOT_ID"
                                 constraintName="FK_BOT_RUNTIME_ON_BOT" onDelete="CASCADE"
                                 referencedTableName="BOT" referencedColumnNames="ID"/>
    </changeSet>

    <changeSet id="5" author="wootify">
        <createTable tableName="BOT_EVENT">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_BOT_EVENT"/>
            </column>
            <column name="BOT_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_AT" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="LAST_OCCURRED_AT" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="REPEAT_COUNT" type="INT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="LEVEL_" type="VARCHAR(8)">
                <constraints nullable="false"/>
            </column>
            <column name="CATEGORY" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="MESSAGE" type="VARCHAR(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="DETAILS" type="CLOB"/>
            <column name="INSTANCE_ID" type="VARCHAR(100)"/>
        </createTable>
        <createIndex tableName="BOT_EVENT" indexName="IDX_BOT_EVENT_BOT_CREATED">
            <column name="BOT_ID"/>
            <column name="CREATED_AT"/>
        </createIndex>
        <createIndex tableName="BOT_EVENT" indexName="IDX_BOT_EVENT_CREATED">
            <column name="CREATED_AT"/>
        </createIndex>
        <addForeignKeyConstraint baseTableName="BOT_EVENT" baseColumnNames="BOT_ID"
                                 constraintName="FK_BOT_EVENT_ON_BOT" onDelete="CASCADE"
                                 referencedTableName="BOT" referencedColumnNames="ID"/>
    </changeSet>

    <changeSet id="6" author="wootify">
        <createTable tableName="BOT_CYCLE">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_BOT_CYCLE"/>
            </column>
            <column name="BOT_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="NUMBER_" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="STATUS" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="DIRECTION" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="STARTED_AT" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="CLOSED_AT" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="BASE_PRICE" type="DECIMAL(28, 12)"/>
            <column name="AVG_ENTRY_PRICE" type="DECIMAL(28, 12)"/>
            <column name="ENTRY_QTY" type="DECIMAL(28, 12)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="ENTRY_COST" type="DECIMAL(28, 12)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="EXIT_QTY" type="DECIMAL(28, 12)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="EXIT_PROCEEDS" type="DECIMAL(28, 12)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="FEES" type="DECIMAL(28, 12)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="FILLED_SAFETY_ORDERS" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="TAKE_PROFIT_PRICE" type="DECIMAL(28, 12)"/>
            <column name="STOP_LOSS_PRICE" type="DECIMAL(28, 12)"/>
            <column name="REALIZED_PNL" type="DECIMAL(28, 12)"/>
            <column name="CLOSE_REASON" type="VARCHAR(32)"/>
            <column name="PLAN" type="CLOB"/>
        </createTable>
        <addUniqueConstraint tableName="BOT_CYCLE" columnNames="BOT_ID, NUMBER_" constraintName="IDX_BOT_CYCLE_UNQ"/>
        <createIndex tableName="BOT_CYCLE" indexName="IDX_BOT_CYCLE_BOT">
            <column name="BOT_ID"/>
        </createIndex>
        <addForeignKeyConstraint baseTableName="BOT_CYCLE" baseColumnNames="BOT_ID"
                                 constraintName="FK_BOT_CYCLE_ON_BOT" onDelete="CASCADE"
                                 referencedTableName="BOT" referencedColumnNames="ID"/>
        <!-- Не более одного незакрытого цикла на бота -->
        <sql>
            CREATE UNIQUE INDEX IDX_BOT_CYCLE_UNQ_ACTIVE ON BOT_CYCLE (BOT_ID) WHERE STATUS &lt;&gt; 'CLOSED'
        </sql>
    </changeSet>

    <changeSet id="7" author="wootify">
        <addColumn tableName="ORDER_">
            <column name="BOT_ID" type="UUID"/>
            <column name="CYCLE_ID" type="UUID"/>
            <column name="CLIENT_ORDER_ID" type="VARCHAR(64)"/>
            <column name="ROLE_" type="VARCHAR(16)"/>
            <column name="GRID_LEVEL" type="INT"/>
            <column name="TRADING_MODE" type="VARCHAR(16)"/>
            <column name="REDUCE_ONLY" type="BOOLEAN"/>
            <column name="ERROR_MESSAGE" type="VARCHAR(1000)"/>
            <column name="UPDATED_DATE" type="DATETIME"/>
        </addColumn>
        <addUniqueConstraint tableName="ORDER_" columnNames="CLIENT_ORDER_ID"
                             constraintName="IDX_ORDER__UNQ_CLIENT_ORDER_ID"/>
        <createIndex tableName="ORDER_" indexName="IDX_ORDER__BOT">
            <column name="BOT_ID"/>
        </createIndex>
        <createIndex tableName="ORDER_" indexName="IDX_ORDER__CYCLE">
            <column name="CYCLE_ID"/>
        </createIndex>
        <addForeignKeyConstraint baseTableName="ORDER_" baseColumnNames="BOT_ID" constraintName="FK_ORDER__ON_BOT"
                                 onDelete="SET NULL" referencedTableName="BOT" referencedColumnNames="ID"/>
        <addForeignKeyConstraint baseTableName="ORDER_" baseColumnNames="CYCLE_ID" constraintName="FK_ORDER__ON_CYCLE"
                                 onDelete="SET NULL" referencedTableName="BOT_CYCLE" referencedColumnNames="ID"/>
    </changeSet>

    <changeSet id="8" author="wootify">
        <createTable tableName="PAPER_ORDER">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_PAPER_ORDER"/>
            </column>
            <column name="CLIENT_ORDER_ID" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="NETWORK" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="SYMBOL" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="SIDE" type="VARCHAR(8)">
                <constraints nullable="false"/>
            </column>
            <column name="TYPE_" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="PRICE" type="DECIMAL(28, 12)"/>
            <column name="QUANTITY" type="DECIMAL(28, 12)">
                <constraints nullable="false"/>
            </column>
            <column name="REDUCE_ONLY" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="STATUS" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="FILLED_QTY" type="DECIMAL(28, 12)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="AVG_PRICE" type="DECIMAL(28, 12)"/>
            <column name="FEE" type="DECIMAL(28, 12)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="REJECT_REASON" type="VARCHAR(500)"/>
            <column name="CREATED_AT" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="UPDATED_AT" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="PAPER_ORDER" columnNames="CLIENT_ORDER_ID"
                             constraintName="IDX_PAPER_ORDER_UNQ_CLIENT_ID"/>
        <!-- Симулятор сканирует только активные ордера -->
        <sql>
            CREATE INDEX IDX_PAPER_ORDER_ACTIVE ON PAPER_ORDER (NETWORK, SYMBOL) WHERE STATUS = 'NEW'
        </sql>
    </changeSet>

</databaseChangeLog>
