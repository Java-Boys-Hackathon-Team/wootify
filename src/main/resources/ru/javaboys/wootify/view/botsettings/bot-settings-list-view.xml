<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://botSettingsListView.title"
      focusComponent="botSettingsesDataGrid">
    <data>
        <collection id="botSettingsesDc"
                    class="ru.javaboys.wootify.entity.BotSettings">
            <fetchPlan extends="_base">
                <property name="symbol" fetchPlan="_base"/>
                <property name="position" fetchPlan="_base"/>
                <property name="bot" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="botSettingsesDl" readOnly="true">
                <query>
                    <![CDATA[select e from BotSettings e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="botSettingsesDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <button id="createButton" action="botSettingsesDataGrid.createAction"/>
            <button id="editButton" action="botSettingsesDataGrid.editAction"/>
            <button id="removeButton" action="botSettingsesDataGrid.removeAction"/>
            <simplePagination id="pagination" dataLoader="botSettingsesDl"/>
        </hbox>
        <dataGrid id="botSettingsesDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="botSettingsesDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="symbol"/>
                <column property="tradeType"/>
                <column property="deposit"/>
                <column property="leverage"/>
                <column property="overlapPersent"/>
                <column property="ordersQuantity"/>
                <column property="profitPersent"/>
                <column property="position"/>
                <column property="state"/>
                <column property="bot"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
