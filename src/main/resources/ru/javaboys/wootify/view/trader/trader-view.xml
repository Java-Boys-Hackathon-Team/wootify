<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://traderView.title">

    <data>
        <!-- Таблица ордеров -->
        <collection id="ordersDc" class="ru.javaboys.wootify.entity.Order">
            <fetchPlan extends="_base"/>
            <loader id="ordersDl">
                <query>
                    <![CDATA[
                        select o from Order_ o
                        where (:position is null or o.position = :position)
                        order by o.createdDate desc
                    ]]>
                </query>
            </loader>
        </collection>

        <!-- Таблица позиций -->
        <collection id="positionsDc" class="ru.javaboys.wootify.entity.Position">
            <fetchPlan extends="_base"/>
            <loader id="positionsDl">
                <query>
                    <![CDATA[
                        select p from Position_ p
                        where (:symbol is null or p.symbol = :symbol)
                            and (:account is null or p.account = :account)
                            and (:apiKey is null or p.apiKey = :apiKey)
                        order by p.createdDate desc
                    ]]>
                </query>
            </loader>
        </collection>
    </data>

    <layout>
        <hbox width="100%" spacing="true">

            <!-- Левая часть: торговая панель -->
            <vbox width="70%" spacing="true">
                <hbox>
                    <entityPicker id="accountEntityPicker"
                                  metaClass="Account"
                                  property="name"
                                  label="Account">
                        <actions>
                            <action id="entityLookup" type="entity_lookup"/>
                        </actions>
                    </entityPicker>

                    <entityPicker id="apiKeyEntityPicker"
                                  metaClass="ApiKey"
                                  property="name"
                                  label="Api Key">
                        <actions>
                            <action id="entityLookup" type="entity_lookup"/>
                        </actions>
                    </entityPicker>
                </hbox>

                <hbox>
                    <textField id="myAssets" label="My Assets (USDC)"/>
                    <vbox>
                        <button id="assetsRefreshButton"
                                text="Refresh Assets"
                                icon="REFRESH"/>
                    </vbox>
                </hbox>

                <hbox>
                    <entityPicker id="symbolEntityPicker"
                                  metaClass="Symbol"
                                  property="name"
                                  label="Ticker">
                        <actions>
                            <action id="entityLookup" type="entity_lookup"/>
                            <action id="entityClear" type="entity_clear"/>
                        </actions>
                    </entityPicker>
                    <comboBox id="orderTypeCombo"
                              label="Order Type"
                              itemsEnum="ru.javaboys.wootify.enums.OrderType"/>
                </hbox>

                <hbox>
                    <numberField id="leverage"
                                 label="Leverage (x)"
                                 min="1" max="100"
                                 step="1"
                                 value="10"
                                 stepButtonsVisible="true"/>
                    <button id="checkLeverageButton"
                            text="Check"
                            classNames="side-btn buy"
                            width="25%"/>
                    <button id="setLeverageButton"
                            text="Set"
                            classNames="side-btn buy"
                            width="25%"/>
                </hbox>

                <vbox classNames="price-box" spacing="false" padding="false" width="fit-content">
                    <h4 text="Prices"/>
                    <hbox classNames="price-fields" spacing="true">
                        <bigDecimalField id="bidPrice" label="Bid" classNames="price-field bid"/>
                        <bigDecimalField id="avgPrice" label="Avg" classNames="price-field avg"/>
                        <bigDecimalField id="askPrice" label="Ask" classNames="price-field ask"/>
                    </hbox>
                </vbox>

                <vbox classNames="trade-box" spacing="true" width="fit-content">

                    <hbox classNames="order-fields">
                        <bigDecimalField id="priceField" label="Price" placeholder="0.00"/>
                        <bigDecimalField id="qtyField" label="Qty" placeholder="0.00"/>
                        <bigDecimalField id="totalField" label="Total" placeholder="0.00"/>
                    </hbox>

                    <hbox classNames="side-buttons">
                        <button id="buyButton"
                                text="BUY"
                                classNames="side-btn buy"
                                width="50%"/>
                        <button id="sellButton"
                                text="SELL"
                                classNames="side-btn sell"
                                width="50%"/>
                    </hbox>

                </vbox>
            </vbox>

            <!-- Правая часть: таблицы -->
            <vbox width="30%" spacing="true">

                <hbox spacing="true">
                    <button id="createPositionBtn"
                            text="Создать позицию"
                            icon="PLUS"
                            classNames="action-button"/>
                    <button id="createOrderBtn"
                            text="Создать ордер"
                            icon="PLUS"
                            classNames="action-button"/>
                </hbox>

                <h4 text="Positions"/>
                <dataGrid id="positionsTable"
                          dataContainer="positionsDc"
                          height="200px"
                          classNames="table">
                    <columns>
                        <column property="symbol.name"/>
                        <column property="positionQty"/>
                        <column property="averageOpenPrice"/>
                        <column property="realizedPnl"/>
                        <column property="status"/>
                        <column key="actions"/>
                    </columns>
                </dataGrid>

                <h4 text="Orders"/>
                <dataGrid id="ordersTable"
                          dataContainer="ordersDc"
                          height="200px"
                          classNames="table">
                    <columns>
                        <column property="symbol.name"/>
                        <column property="price"/>
                        <column property="quantity"/>
                        <column property="averageExecutedPrice"/>
                        <column property="totalExecutedQuantity"/>
                        <column property="status"/>
                        <column key="actions"/>
                    </columns>
                </dataGrid>

            </vbox>
        </hbox>
    </layout>
</view>