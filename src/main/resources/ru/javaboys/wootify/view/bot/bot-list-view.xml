<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://botListView.title"
      focusComponent="botsDataGrid">
    <data>
        <collection id="botsDc"
                    class="ru.javaboys.wootify.entity.Bot">
            <fetchPlan extends="_base">
                <property name="symbol" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="botsDl" readOnly="true">
                <query>
                    <![CDATA[select e from Bot e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="botsDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <button id="createButton" action="botsDataGrid.createAction"/>
            <button id="editButton" action="botsDataGrid.editAction"/>
            <button id="removeButton" action="botsDataGrid.removeAction"/>
            <simplePagination id="pagination" dataLoader="botsDl"/>
        </hbox>
        <dataGrid id="botsDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="botsDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="symbol"/>
                <column property="name"/>
                <column property="startDateTime"/>
                <column property="endDateTime"/>
                <column property="errorMessage"/>
                <column property="desiredState"/>
                <column property="runtimeState"/>
                <column property="lastHeartBeat"/>
                <column property="ownerInstance"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
