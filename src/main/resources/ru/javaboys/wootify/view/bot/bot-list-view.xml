<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://botListView.title"
      focusComponent="botsDataGrid">
    <data>
        <collection id="botsDc"
                    class="ru.javaboys.wootify.entity.Bot">
            <fetchPlan extends="_base">
                <property name="symbol" fetchPlan="_base"/>
                <property name="runtime" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="botsDl" readOnly="true">
                <query>
                    <![CDATA[select e from Bot e order by e.name]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <timer id="refreshTimer" delay="3000" autostart="true" repeating="true"/>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <hbox id="summaryBox" classNames="bot-summary" alignItems="CENTER">
            <span id="summaryText"/>
        </hbox>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <button id="createButton" action="botsDataGrid.createAction"/>
            <button id="editButton" action="botsDataGrid.editAction"/>
            <button id="removeButton" text="Удалить" icon="TRASH"/>
            <button id="eventsButton" text="Журнал ботов" icon="LIST_UL"/>
        </hbox>
        <dataGrid id="botsDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="botsDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
            </actions>
            <columns resizable="true">
                <column property="name" width="16em" flexGrow="0" frozen="true"/>
                <column key="status" header="Статус" autoWidth="true" flexGrow="0"/>
                <column key="controls" header="Управление" autoWidth="true" flexGrow="0"/>
                <column key="activity" header="Текущее занятие" width="26em" flexGrow="3"/>
                <column key="heartbeat" header="Пульс" autoWidth="true" flexGrow="0"/>
                <column key="cycles" header="Циклов" autoWidth="true" flexGrow="0"/>
                <column key="pnl" header="Результат, USDC" autoWidth="true" flexGrow="0"/>
                <column property="symbol" autoWidth="true" flexGrow="0"/>
                <column property="tradingMode" autoWidth="true" flexGrow="0"/>
                <column property="network" autoWidth="true" flexGrow="0"/>
                <column key="lastError" header="Последняя ошибка" width="18em" flexGrow="2"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
