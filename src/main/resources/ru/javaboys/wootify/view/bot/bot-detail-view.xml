<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://botDetailView.title"
      focusComponent="form">
    <data>
        <instance id="botDc"
                  class="ru.javaboys.wootify.entity.Bot">
            <fetchPlan extends="_base">
                <property name="symbol" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="botDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="botDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <entityPicker id="symbolField" property="symbol">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
            <textField id="nameField" property="name"/>
            <dateTimePicker id="startDateTimeField" property="startDateTime"/>
            <dateTimePicker id="endDateTimeField" property="endDateTime"/>
            <textArea id="errorMessageField" height="9.5em" property="errorMessage"/>
            <select id="desiredStateField" property="desiredState"/>
            <select id="runtimeStateField" property="runtimeState"/>
            <textField id="lastHeartBeatField" property="lastHeartBeat"/>
            <textField id="ownerInstanceField" property="ownerInstance"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
