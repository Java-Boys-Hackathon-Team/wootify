<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://positionDetailView.title"
      focusComponent="form">
    <data>
        <instance id="positionDc"
                  class="ru.javaboys.wootify.entity.Position">
            <fetchPlan extends="_base">
                <property name="apiKey" fetchPlan="_base"/>
                <property name="account" fetchPlan="_base"/>
                <property name="symbol" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="positionDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="positionDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <select id="statusField" property="status"/>
            <entityPicker id="apiKeyField" property="apiKey">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
            <entityPicker id="accountField" property="account">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
            <dateTimePicker id="createdDateField" property="createdDate"/>
            <entityPicker id="symbolField" property="symbol">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
            <dateTimePicker id="closedDateField" property="closedDate"/>
            <textField id="leverageField" property="leverage"/>
            <bigDecimalField id="positionQtyField" property="positionQty"/>
            <bigDecimalField id="averageOpenPriceField" property="averageOpenPrice"/>
            <bigDecimalField id="realizedPnlField" property="realizedPnl"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
