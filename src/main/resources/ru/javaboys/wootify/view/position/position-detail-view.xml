<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://positionDetailView.title"
      focusComponent="form">
    <data>
        <instance id="positionDc"
                  class="ru.javaboys.wootify.entity.Position">
            <fetchPlan extends="_base">
                <property name="account" fetchPlan="_base"/>
                <property name="symbol" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="positionDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="positionDc">
            <entityPicker id="symbolsPicker" dataContainer="positionDc" property="symbol">
                <actions>
                    <action id="entityLookup" type="entity_lookup"/>
                    <action id="entityOpen" type="entity_open"/>
                </actions>
            </entityPicker>
            <entityPicker id="accountsPicker" dataContainer="positionDc" property="account">
                <actions>
                    <action id="entityLookup" type="entity_lookup"/>
                    <action id="entityOpen" type="entity_open"/>
                </actions>
            </entityPicker>
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <dateTimePicker id="timestampField" property="timestamp"/>
            <bigDecimalField property="positionQty" label="Quantity:" decimals="4"/>
            <bigDecimalField property="settlePrice" decimals="4"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
