<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://symbolListView.title"
      focusComponent="symbolsDataGrid">
    <data>
        <collection id="symbolsDc"
                    class="ru.javaboys.wootify.entity.Symbol">
            <fetchPlan extends="_base"/>
            <loader id="symbolsDl" readOnly="true">
                <query>
                    <![CDATA[select e from Symbol e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="symbolsDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <button id="createButton" action="symbolsDataGrid.createAction"/>
            <button id="editButton" action="symbolsDataGrid.editAction"/>
            <button id="removeButton" action="symbolsDataGrid.removeAction"/>
            <simplePagination id="pagination" dataLoader="symbolsDl"/>
        </hbox>
        <dataGrid id="symbolsDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="symbolsDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="name"/>
                <column property="woofiTicker"/>
                <column property="analogTicker"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
