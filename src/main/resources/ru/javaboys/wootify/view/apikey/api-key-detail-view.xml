<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://apiKeyDetailView.title"
      focusComponent="form">
    <data>
        <instance id="apiKeyDc"
                  class="ru.javaboys.wootify.entity.ApiKey">
            <fetchPlan extends="_base">
                <property name="account" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="apiKeyDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="apiKeyDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <textField id="nameField" property="name"/>
            <entityPicker id="accountField" property="account">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
            <textField id="keyField" property="key"/>
            <textField id="secretField" property="secret"/>
            <textField id="exchangeIdField" property="exchangeId"/>
            <textField id="brokerIdField" property="brokerId"/>
            <textField id="envField" property="env"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
