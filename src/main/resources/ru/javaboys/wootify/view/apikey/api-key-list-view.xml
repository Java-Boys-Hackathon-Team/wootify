<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://apiKeyListView.title"
      focusComponent="apiKeysDataGrid">
    <data>
        <collection id="apiKeysDc"
                    class="ru.javaboys.wootify.entity.ApiKey">
            <fetchPlan extends="_base">
                <property name="account" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="apiKeysDl" readOnly="true">
                <query>
                    <![CDATA[select e from ApiKey e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="apiKeysDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <button id="createButton" action="apiKeysDataGrid.createAction"/>
            <button id="editButton" action="apiKeysDataGrid.editAction"/>
            <button id="removeButton" action="apiKeysDataGrid.removeAction"/>
            <simplePagination id="pagination" dataLoader="apiKeysDl"/>
        </hbox>
        <dataGrid id="apiKeysDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="apiKeysDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="name"/>
                <column property="account"/>
                <column property="env"/>
                <column property="exchangeId"/>
                <column property="brokerId"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
